# Copy to .env or set in Cloudflare Pages → Settings → Variables
# Contact form
CONTACT_TO=janonguittard@gmail.com
CONTACT_FROM_DOMAIN=ewii.site

# Email Service (choose one)
# - Pages Functions binding: EMAIL (send_email)
# - REST: CLOUDFLARE_ACCOUNT_ID + CLOUDFLARE_API_TOKEN (Email Sending: Edit)
# - Fallback: RESEND_API_KEY
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
RESEND_API_KEY=

# Newsletter (EmailOctopus)
EMAILOCTOPUS_API_KEY=
EMAILOCTOPUS_LIST_ID=

# Rate limit KV (Pages → Settings → Functions → KV: CONTACT_RL)
# CONTACT_RL is a KV namespace binding, not a string value
